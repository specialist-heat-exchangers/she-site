# GitHub Pages project URL (default if these are unset at build time)
NEXT_PUBLIC_BASE_PATH=/she-site
NEXT_PUBLIC_SITE_URL=https://specialist-heat-exchangers.github.io

# Custom domain: serve from the root and point Open Graph URLs at the new origin.
# NEXT_PUBLIC_BASE_PATH=
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Formspree (or later HubSpot) endpoint. Leave empty to use the mailto fallback.
NEXT_PUBLIC_FORM_ENDPOINT=
